# Copy to /home/ubuntu/.restic.env and set mode 600.
export AWS_ACCESS_KEY_ID=replace-with-r2-access-key
export AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-key
export RESTIC_REPOSITORY=s3:https://replace-with-account-id.r2.cloudflarestorage.com/replace-with-bucket/cn-hk-grafana
export RESTIC_PASSWORD=replace-with-independent-repository-password
