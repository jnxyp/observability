          "refId": "A",
          "expr": "sum by(instance) (rate(caddy_http_response_size_bytes_sum{job=\"integrations/caddy\",instance=~`${instance:regex}`,handler=\"subroute\",host!=\"\"}[$__rate_interval]))",
