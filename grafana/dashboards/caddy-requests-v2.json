{
  "uid": "caddy-requests-v2",
  "title": "Caddy / Requests & Latency",
  "tags": [
    "caddy",
    "self-hosted"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
