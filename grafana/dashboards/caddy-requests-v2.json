{
  "uid": "caddy-requests-v2",
  "title": "Caddy / 请求与延迟",
  "tags": [
    "caddy",
    "self-hosted"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "服务器",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(up{job=\"integrations/caddy\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"integrations/caddy\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "域名",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(caddy_http_requests_total{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host!=\"\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(caddy_http_requests_total{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host!=\"\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "handler",
        "label": "路由类型",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "query": "label_values(caddy_http_requests_total{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\"}, handler)",
          "refId": "handler"
        },
        "definition": "label_values(caddy_http_requests_total{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\"}, handler)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "options": [],
        "current": {
          "text": "subroute",
          "value": "subroute"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "请求概览 · 默认统计业务路由；可切换路由类型查看重定向",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "当前请求速率",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "noValue": "—"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\",handler=~\"${handler:regex}\"}[$__rate_interval]))",
          "legendFormat": "QPS",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false,
          "instant": true,
          "interval": "30s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "所选时段请求数",
      "description": "按计数器增量估算；新增域名标签之前的数据不纳入此视图。",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "noValue": "—"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(caddy_http_request_duration_seconds_count{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\",handler=~\"${handler:regex}\"}[$__range]))",
          "legendFormat": "请求数",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false,
          "instant": true,
          "interval": "30s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "当前 5xx 比例",
      "description": "无请求时不显示比例。Caddy 内部处理错误与 HTTP 5xx 是不同口径。",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "noValue": "—",
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(caddy_http_request_duration_seconds_count{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\",handler=~\"${handler:regex}\",code=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(caddy_http_request_duration_seconds_count{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\",handler=~\"${handler:regex}\"}[$__rate_interval])))) / (sum(rate(caddy_http_request_duration_seconds_count{job=\"integrations/caddy\",instance=~\"${instance:regex}\",host=~\"${host:regex}\",handler=~\"${handler:regex}\"}[$__rate_interval])))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false,
          "instant": true,
          "interval": "30s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
