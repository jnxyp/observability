# Copy to .env on the server, set mode 600, and replace every placeholder.
OBSERVABILITY_ROOT=/home/ubuntu/docker_projects/observability
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_EMAIL=admin@example.com
POSTGRES_PASSWORD=replace-with-random-secret
GRAFANA_ADMIN_PASSWORD=replace-with-random-secret
GRAFANA_SECRET_KEY=replace-with-random-secret
SMTP_PASSWORD=replace-with-resend-smtp-secret
SMTP_FROM_ADDRESS=grafana@example.com
COS_ACCESS_KEY_ID=replace-with-cos-secret-id
COS_SECRET_ACCESS_KEY=replace-with-cos-secret-key
COS_ENDPOINT=cos.replace-with-region.myqcloud.com
COS_REGION=replace-with-region
COS_BUCKET_NAME=replace-with-bucket-name
